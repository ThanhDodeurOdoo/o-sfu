{
  "name": "@o-sfu/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser shell groundwork for o-sfu",
  "scripts": {
    "lint": "eslint src scripts test playwright eslint.config.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "wasm:build": "node ./scripts/build_wasm_runtime.mjs",
    "wasm:check-size": "node ./scripts/check_wasm_size.mjs",
    "build": "npm run wasm:build && tsc -p tsconfig.json && npm run wasm:check-size",
    "build:odoo": "npm run wasm:build && npm run wasm:check-size && node ./scripts/build_odoo_bundle.mjs",
    "test": "npm run test:unit",
    "test:unit": "npm run build && node --test \"./test/**/*.test.mjs\"",
    "test:browser": "npm run build && playwright test",
    "test:browser:chromium": "npm run test:browser -- --project=chromium",
    "test:browser:firefox": "npm run test:browser -- --project=firefox",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run test:browser && npm run build:odoo"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-n": "^17.23.1",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.5.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1"
  }
}

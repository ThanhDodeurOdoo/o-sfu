{
  "name": "@o-sfu/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser shell groundwork for o-sfu",
  "scripts": {
    "build:wasm": "node ./scripts/build_wasm_runtime.mjs",
    "check:wasm-size": "node ./scripts/check_wasm_size.mjs",
    "build": "npm run build:wasm && tsc -p tsconfig.json && npm run check:wasm-size",
    "lint": "eslint src scripts test eslint.config.mjs",
    "test": "npm run build && node --test ./test/**/*.mjs",
    "typscript": "tsc --noEmit -p tsconfig.json",
    "verify": "npm run lint && npm run typscript && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.0",
    "eslint-plugin-n": "^17.23.1",
    "globals": "^17.5.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "prettier": "^3.5.3",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-prettier": "^5.5.5"
  }
}
